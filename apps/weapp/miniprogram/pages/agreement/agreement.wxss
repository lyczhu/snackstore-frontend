.agreement-page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.doc-meta {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}

.doc-summary {
  margin-bottom: 32rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.doc-section {
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: var(--radius-card);
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  color: var(--color-text);
}

.paragraph {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.bullet-list {
  margin-top: 8rpx;
}

.bullet {
  margin-bottom: 8rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.back-btn {
  margin-top: 16rpx;
}
