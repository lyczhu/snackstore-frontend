.order-list {
  padding-bottom: 32rpx;
}

.error-retry {
  padding: 32rpx;
}

.orders {
  padding: 24rpx 32rpx;
}

.order-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: var(--radius-card);
}

.order-card--hover {
  transform: scale(0.98);
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 26rpx;
  color: var(--color-text-placeholder);
}

.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.order-actions {
  display: flex;
}

.action-btn--gap {
  margin-left: 16rpx;
}
