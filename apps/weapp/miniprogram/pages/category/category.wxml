<view class="category-page">
  <view class="page-main-title">商品分类</view>

  <scroll-view class="category-tabs" scroll-x enable-flex>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="category-tab-btn {{currentCategoryId === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bind:tap="selectCategory"
    >{{item.name}}</view>
  </scroll-view>

  <view wx:if="{{loadError}}" class="error-retry" bind:tap="init">
    <van-empty image="error" description="加载失败，点击重试" />
  </view>

  <block wx:else>
    <van-skeleton wx:if="{{initialLoading}}" title row="6" />
    <view wx:else class="product-list">
      <product-card
        class="list-item"
        wx:for="{{items}}"
        wx:key="id"
        product="{{item}}"
        mode="list"
      />
    </view>

    <van-divider wx:if="{{finished && items.length > 0}}" contentPosition="center">没有更多了</van-divider>
    <van-empty wx:if="{{!initialLoading && !loading && items.length === 0}}" description="暂无商品" />
  </block>
</view>
