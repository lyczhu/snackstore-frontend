.category-page {
  padding: 32rpx;
}

.page-main-title {
  margin-bottom: 32rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #323233;
}

.category-tabs {
  display: flex;
  white-space: nowrap;
  margin-bottom: 40rpx;
}

.category-tab-btn {
  flex: none;
  margin-right: 20rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #323233;
  background: #f7f8fa;
  border-radius: 32rpx;
}

.category-tab-btn.active {
  color: #fff;
  background: var(--color-primary);
}

/* 卡片内部样式在 components/product-card；页面只保留单列间距 */
.list-item {
  display: block;
  margin-bottom: 24rpx;
}
