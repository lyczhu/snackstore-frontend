.payment-page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.demo-banner {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: #e55a2b;
  background: #fff7ed;
  border-radius: var(--radius-card);
}

.amount-card {
  margin-bottom: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  background: #fff;
  border-radius: var(--radius-card);
}

.label {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.amount {
  font-size: 64rpx;
  font-weight: bold;
  color: var(--color-primary);
}

.symbol {
  margin-right: 4rpx;
  font-size: 36rpx;
}

.countdown {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.info-card {
  margin-bottom: 40rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: var(--radius-card);
}

.info-line {
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.result {
  padding: 48rpx 0;
  text-align: center;
}

.result-text {
  margin-top: 16rpx;
  font-size: 32rpx;
  color: var(--color-text);
}

.later-btn {
  margin-top: 24rpx;
}
