<view class="address-list">
  <!-- H5 把「新增」放在导航栏右侧；小程序原生导航栏无自定义右侧按钮，改为页内顶部按钮 -->
  <van-button size="small" type="primary" plain icon="plus" bind:click="showAddDialog">
    新增地址
  </van-button>

  <view wx:if="{{loadError}}" class="error-retry" bind:tap="retry">
    <van-empty image="error" description="加载失败，点击重试" />
  </view>

  <block wx:else>
    <van-skeleton wx:if="{{initialLoading}}" title row="4" />
    <view wx:else class="addresses">
      <view wx:for="{{addresses}}" wx:key="id" class="address-card">
        <view class="address-info">
          <view class="receiver">
            <text class="name">{{item.receiverName}}</text>
            <text class="phone">{{item.receiverPhone}}</text>
            <van-tag wx:if="{{item.isDefault === 1}}" type="primary">默认</van-tag>
          </view>
          <view class="detail">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</view>
        </view>
        <view class="actions">
          <van-button
            size="small"
            plain
            type="primary"
            data-id="{{item.id}}"
            bind:click="editAddress"
          >
            编辑
          </van-button>
          <van-button
            wx:if="{{item.isDefault !== 1}}"
            class="action-gap"
            size="small"
            plain
            data-id="{{item.id}}"
            bind:click="setDefault"
          >
            设为默认
          </van-button>
          <van-button
            class="action-gap"
            size="small"
            plain
            type="danger"
            data-id="{{item.id}}"
            bind:click="handleDelete"
          >
            删除
          </van-button>
        </view>
      </view>
      <van-empty wx:if="{{addresses.length === 0}}" description="暂无收货地址" />
    </view>
  </block>

  <!-- 地址表单：底部弹层（对齐 H5，替代宽对话框） -->
  <van-popup show="{{dialogVisible}}" position="bottom" round bind:close="closeDialog">
    <view class="address-form">
      <view class="form-title">{{isEdit ? '编辑地址' : '新增地址'}}</view>

      <van-field
        label="收货人"
        required
        value="{{form.receiverName}}"
        placeholder="请输入收货人姓名"
        error-message="{{errors.receiverName}}"
        data-field="receiverName"
        bind:change="onField"
      />
      <van-field
        label="手机号"
        required
        type="number"
        maxlength="11"
        value="{{form.receiverPhone}}"
        placeholder="请输入手机号"
        error-message="{{errors.receiverPhone}}"
        data-field="receiverPhone"
        bind:change="onField"
      />
      <van-field
        label="省份"
        value="{{form.province}}"
        placeholder="省份"
        data-field="province"
        bind:change="onField"
      />
      <van-field
        label="城市"
        value="{{form.city}}"
        placeholder="城市"
        data-field="city"
        bind:change="onField"
      />
      <van-field
        label="区县"
        value="{{form.district}}"
        placeholder="区县"
        data-field="district"
        bind:change="onField"
      />
      <van-field
        label="详细地址"
        required
        type="textarea"
        autosize
        value="{{form.detail}}"
        placeholder="请输入详细地址"
        error-message="{{errors.detail}}"
        data-field="detail"
        bind:change="onField"
      />
      <van-field label="默认地址" border="{{false}}">
        <van-switch
          slot="input"
          checked="{{form.isDefault === 1}}"
          size="48rpx"
          bind:change="onDefaultChange"
        />
      </van-field>

      <view class="form-actions">
        <!-- 提交防重复：loading 态按钮不可点，双击不会创建重复地址 -->
        <van-button block round type="primary" loading="{{submitting}}" bind:click="submitForm">
          确定
        </van-button>
        <van-button class="cancel-btn" block round bind:click="closeDialog">取消</van-button>
      </view>
    </view>
  </van-popup>
</view>
