.goods-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--color-border);
}

.goods-item:last-child {
  border-bottom: none;
}

.item-image {
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
  padding: 0 24rpx;
}

.name {
  font-size: 28rpx;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--color-primary);
}
