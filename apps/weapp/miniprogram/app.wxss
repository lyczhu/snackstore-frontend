/* ===================== 设计 token（源自 apps/mobile/src/styles/tokens.css） =====================
   H5 的 :root 在小程序对应 page{}；自定义属性可跨自定义组件边界继承，
   因此 Vant Weapp 的主题覆盖也统一在此声明（spec P6 / Task 25 的 token 部分提前落地，
   避免各页 wxss 先写死色再返工）。尺寸按 1px = 2rpx 换算。 */
page {
  /* 品牌与语义色（与 H5 同值，色值不随 rpx 缩放） */
  --color-primary: #e55a2b; /* 橙底白字对比度 ≥ 4.5:1 */
  --color-primary-raw: #ff6b35; /* 仅用于装饰性渐变背景 */
  --color-primary-light: #ff8f65;
  --color-danger: #ee0a24; /* Vant danger 语义色，两端一致 */
  --color-text: #333;
  --color-text-secondary: #666;
  --color-text-placeholder: #767676;
  --color-bg: #f5f5f5;
  --color-border: #eee;
  --radius-card: 16rpx;
  --shadow-bar: 0 -4rpx 16rpx rgba(0, 0, 0, 0.1);

  /* 基础视觉 */
  background: var(--color-bg);
  color: var(--color-text);
  font-family:
    -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6; /* 中文正文行高 */
}

/* ===================== Vant Weapp 主题：主色统一为品牌橙 =====================
   对齐 H5 的 `--van-primary-color: var(--color-primary)`，消除「微信绿 + 品牌橙」双色并存。
   danger（红）语义色保持 Vant 默认，与 H5 行为一致。变量名取自 lib 内实际 fallback。 */
page {
  --button-primary-background-color: var(--color-primary);
  --button-primary-border-color: var(--color-primary);
  --checkbox-checked-icon-color: var(--color-primary);
  --radio-checked-icon-color: var(--color-primary);
  --switch-on-background-color: var(--color-primary);
  --rate-icon-full-color: var(--color-primary);
  --tabs-bottom-bar-color: var(--color-primary);
  --sidebar-selected-border-color: var(--color-primary);
  --tree-select-item-active-color: var(--color-primary);
  --dropdown-menu-option-active-color: var(--color-primary);
  --dropdown-menu-title-active-text-color: var(--color-primary);
  --index-anchor-active-text-color: var(--color-primary);
  --calendar-selected-day-background-color: var(--color-primary);
  --calendar-range-edge-background-color: var(--color-primary);
  --calendar-range-middle-color: var(--color-primary);
}

/* 文本颜色跟随 token：Vant 组件默认灰阶与 H5 不同，统一校正主要几处 */
page {
  --cell-border-color: var(--color-border);
  --field-label-color: var(--color-text-secondary);
  --field-input-text-color: var(--color-text);
}
