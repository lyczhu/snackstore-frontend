[
  {
    "name": "mobile 入口 JS (gzip)",
    "path": "dist/assets/index-*.js",
    "limit": "10 KB",
    "gzip": true
  },
  {
    "name": "mobile 首屏 vendor JS (gzip)",
    "path": "dist/assets/vendor-*.js",
    "limit": "100 KB",
    "gzip": true
  },
  {
    "name": "mobile 全部 JS 合计（不含省市区数据，gzip）",
    "path": ["dist/assets/*.js", "!dist/assets/area-data-*.js"],
    "limit": "150 KB",
    "gzip": true
  },
  {
    "name": "mobile 省市区数据（地址页按需加载，gzip）",
    "path": "dist/assets/area-data-*.js",
    "limit": "40 KB",
    "gzip": true
  }
]
